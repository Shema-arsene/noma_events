NODE_ENV=development
PORT=4000
# Used to build the CORS allow-list and links in outgoing notifications.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# When true, the API starts an in-memory MongoDB automatically (no install/Docker needed).
# Set to false and point MONGODB_URI at a real MongoDB instance for staging/production
# (required in production — see README).
USE_IN_MEMORY_DB=true
# If using MongoDB Atlas: prefer the non-SRV connection string (the one listing
# ...-shard-00-00/01/02... hosts directly) over mongodb+srv://. SRV connection
# strings need a DNS SRV record lookup, which fails with "querySrv ECONNREFUSED"
# on some Windows/ISP/VPN DNS setups even when normal DNS resolution works fine.
# Both forms are on your cluster's "Connect" page in the Atlas dashboard.
# Remember to include a database name in the path (e.g. "/noma_events") —
# without one, Mongo defaults to a database named "test".
MONGODB_URI=mongodb://localhost:27017/noma_events
REDIS_URL=redis://localhost:6379

# Generate strong random values for these before deploying anywhere real, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret_change_me_refresh_secret

STORAGE_PROVIDER=local
STORAGE_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=

PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=mock_key
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret

EMAIL_PROVIDER=dev
EMAIL_API_KEY=
