    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "multer": "^2.3.0",
    "nanoid": "^3.3.19",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
