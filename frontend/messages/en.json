  "help": {
    "metaTitle": "Help & FAQ",
    "metaDescription": "Frequently asked questions about buying tickets, refunds, and using Noma Events.",
    "title": "Help & FAQ",
    "items": [
      {
        "q": "How do I buy a ticket?",
        "a": "Find an event, choose your ticket type and quantity, then follow the payment steps. Your digital ticket with QR code will be available immediately in your account after payment confirmation."
      },
      {
        "q": "How do I get my ticket?",
        "a": "Your tickets are available under \"My tickets\" in your account, each with a unique QR code to present at the door."
      },
      {
        "id": "refund",
        "q": "Can I get a refund?",
        "a": "Tickets are non-refundable except if the event is cancelled by the organizer. In that case, you'll be automatically notified."
      },
      {
        "q": "What happens if an event is cancelled?",
        "a": "Your tickets for a cancelled event are automatically invalidated and you'll receive a notification."
      },
      {
        "q": "How do I become an organizer on Noma Events?",
        "a": "Create an account, then head to the organizer space to create your profile and publish your first event."
      },
      {
        "q": "What payment methods are accepted?",
        "a": "We're working on integrating the main mobile and bank payment methods in Gabon. During the test phase, a demo payment mode is used."
      }
    ]
  },
